{
	"info": {
		"_postman_id": "a8f5b1e9-a5e8-4e4a-8b0a-7e8f6a2c1d0d",
		"name": "RxDetect API",
		"description": "Postman collection for the RxDetect backend API.\n\nRole-based access control:\n- **pharmacist** — upload, analyse, submit feedback, delete own prescriptions\n- **admin** — full access including deleting any prescription\n- **viewer** — read-only (list/get/status/results only)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Register User",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"pharmacist@example.com\",\n    \"password\": \"securepassword123\",\n    \"full_name\": \"John Doe\",\n    \"role\": \"pharmacist\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/register",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"register"
							]
						},
						"description": "Create a new user account. Roles can be `pharmacist`, `admin`, or `viewer`."
					},
					"response": []
				},
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Successful login\", function () {",
									"    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
									"});",
									"var json = pm.response.json();",
									"if (json.access_token) {",
									"    pm.collectionVariables.set(\"access_token\", json.access_token);",
									"}",
									"if (json.refresh_token) {",
									"    pm.collectionVariables.set(\"refresh_token\", json.refresh_token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/x-www-form-urlencoded"
							}
						],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{
									"key": "username",
									"value": "pharmacist@example.com"
								},
								{
									"key": "password",
									"value": "securepassword123"
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"login"
							]
						},
						"description": "Login with email + password (OAuth2 form). Returns access_token and refresh_token. The test script auto-saves these to collection variables."
					},
					"response": []
				},
				{
					"name": "Refresh Token",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"refresh_token\": \"{{refresh_token}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/refresh",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"refresh"
							]
						},
						"description": "Exchange a valid refresh token for a new access + refresh token pair."
					},
					"response": []
				},
				{
					"name": "Get Current User",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v1/auth/me",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"me"
							]
						},
						"description": "Returns the profile of the currently authenticated user including their role."
					},
					"response": []
				},
				{
					"name": "Logout",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v1/auth/logout",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"logout"
							]
						},
						"description": "Revoke the current refresh token."
					},
					"response": []
				}
			],
			"auth": {
				"type": "bearer",
				"bearer": [
					{
						"key": "token",
						"value": "{{access_token}}",
						"type": "string"
					}
				]
			},
			"description": "Authentication endpoints — register, login, token refresh, logout, and current user profile."
		},
		{
			"name": "Patients",
			"item": [
				{
					"name": "List Patients",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v1/patients/?search=",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"patients",
								""
							],
							"query": [
								{
									"key": "search",
									"value": "",
									"description": "(Optional) Search by patient name or ID."
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "Get Patient",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v1/patients/:patient_id",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"patients",
								":patient_id"
							],
							"variable": [
								{
									"key": "patient_id",
									"value": "your_patient_id_here"
								}
							]
						}
					},
					"response": []
				}
			],
			"auth": {
				"type": "bearer",
				"bearer": [
					{
						"key": "token",
						"value": "{{access_token}}",
						"type": "string"
					}
				]
			},
			"description": "CRUD operations for patient records."
		},
		{
			"name": "Prescriptions",
			"item": [
				{
					"name": "Upload Prescription",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "file",
									"type": "file",
									"src": []
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/api/v1/prescriptions/upload?patient_id=",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"prescriptions",
								"upload"
							],
							"query": [
								{
									"key": "patient_id",
									"value": "",
									"description": "(Optional) Link to an existing patient ID.",
									"disabled": true
								}
							]
						},
						"description": "Upload a prescription image (JPEG, PNG, WEBP) or PDF. Triggers the AI analysis pipeline. Returns a `prescription_id` to poll for status.\n\n**Roles:** pharmacist, admin"
					},
					"response": []
				},
				{
					"name": "List Prescriptions",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v1/prescriptions/?page=1&page_size=20",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"prescriptions",
								""
							],
							"query": [
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "page_size",
									"value": "20"
								},
								{
									"key": "status",
									"value": "analyzed",
									"description": "Filter by status: uploaded | processing | ocr_done | validated | analyzed | failed",
									"disabled": true
								}
							]
						},
						"description": "Paginated list of prescriptions. Admins see all; pharmacists and viewers see only their own.\n\n**Roles:** all authenticated"
					},
					"response": []
				},
				{
					"name": "Get Prescription Details",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v1/prescriptions/:prescription_id",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"prescriptions",
								":prescription_id"
							],
							"variable": [
								{
									"key": "prescription_id",
									"value": "your_prescription_id_here"
								}
							]
						},
						"description": "Full prescription details including extracted fields.\n\n**Roles:** all authenticated (pharmacist/viewer: own prescriptions only)"
					},
					"response": []
				},
				{
					"name": "Get Analysis Status",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v1/prescriptions/:prescription_id/status",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"prescriptions",
								":prescription_id",
								"status"
							],
							"variable": [
								{
									"key": "prescription_id",
									"value": "your_prescription_id_here"
								}
							]
						},
						"description": "Poll this endpoint to check the status of the background analysis task. Status values: `uploaded` → `processing` → `ocr_done` → `validated` → `analyzed` (or `failed`).\n\n**Roles:** all authenticated"
					},
					"response": []
				},
				{
					"name": "Get Analysis Results",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v1/prescriptions/:prescription_id/results",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"prescriptions",
								":prescription_id",
								"results"
							],
							"variable": [
								{
									"key": "prescription_id",
									"value": "your_prescription_id_here"
								}
							]
						},
						"description": "Once status is `analyzed`, returns the full discrepancy report including label, confidence, rule findings, checklist items, and evidence sources.\n\nReturns HTTP 202 if analysis is still in progress.\n\n**Roles:** all authenticated"
					},
					"response": []
				},
				{
					"name": "Submit Pharmacist Feedback",
					"request": {
						"method": "PATCH",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"pharmacist_label\": \"Omission\",\n    \"feedback_note\": \"Dose frequency was missing on the original prescription.\",\n    \"is_correct\": false\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/v1/prescriptions/feedback/:prescription_id",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"prescriptions",
								"feedback",
								":prescription_id"
							],
							"variable": [
								{
									"key": "prescription_id",
									"value": "your_prescription_id_here"
								}
							]
						},
						"description": "Submit a pharmacist correction for the AI verdict. Used for active learning — the corrected label and note are stored on the DiscrepancyReport.\n\n**Roles:** pharmacist, admin"
					},
					"response": []
				},
				{
					"name": "Delete Prescription (Soft)",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v1/prescriptions/:prescription_id",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"prescriptions",
								":prescription_id"
							],
							"variable": [
								{
									"key": "prescription_id",
									"value": "your_prescription_id_here"
								}
							]
						},
						"description": "Soft-delete a prescription by setting `deleted_at` timestamp. The associated DiscrepancyReport is also hard-deleted to prevent orphaned rows.\n\nReturns HTTP 204 No Content on success.\n\n**RBAC:**\n- `admin` — can delete any prescription\n- `pharmacist` — can delete **own** prescriptions only (403 for others')\n- `viewer` — cannot delete (403)\n\n**Note:** Soft-deleted prescriptions are excluded from all list/get queries. This cannot be undone via the API."
					},
					"response": []
				}
			],
			"auth": {
				"type": "bearer",
				"bearer": [
					{
						"key": "token",
						"value": "{{access_token}}",
						"type": "string"
					}
				]
			},
			"description": "Endpoints for uploading, analysing, managing, and deleting prescriptions."
		},
		{
			"name": "Reports",
			"item": [
				{
					"name": "List Reports",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v1/reports/?page=1&page_size=20",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"reports",
								""
							],
							"query": [
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "page_size",
									"value": "20"
								}
							]
						},
						"description": "Paginated list of all generated discrepancy reports.\n\n**Roles:** all authenticated"
					},
					"response": []
				},
				{
					"name": "Generate PDF Report",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v1/reports/generate/:prescription_id",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"reports",
								"generate",
								":prescription_id"
							],
							"variable": [
								{
									"key": "prescription_id",
									"value": "your_prescription_id_here"
								}
							]
						},
						"description": "Generate (or re-generate) the PDF summary report for an analyzed prescription. Generated in-memory via ReportLab — no disk writes.\n\n**Roles:** pharmacist, admin"
					},
					"response": []
				},
				{
					"name": "Download PDF Report",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v1/reports/download/:prescription_id",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"reports",
								"download",
								":prescription_id"
							],
							"variable": [
								{
									"key": "prescription_id",
									"value": "your_prescription_id_here"
								}
							]
						},
						"description": "Download the generated PDF file as a binary stream.\n\n**Roles:** pharmacist, admin"
					},
					"response": []
				}
			],
			"auth": {
				"type": "bearer",
				"bearer": [
					{
						"key": "token",
						"value": "{{access_token}}",
						"type": "string"
					}
				]
			},
			"description": "Endpoints for generating and downloading PDF audit reports."
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://127.0.0.1:8000",
			"type": "string"
		},
		{
			"key": "access_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "refresh_token",
			"value": "",
			"type": "string"
		}
	]
}
